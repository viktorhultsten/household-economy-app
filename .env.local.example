# Copy this file to `.env` and fill in your values.
#
# Postgres connection used by the app, the tsx scripts, and docker-compose.
# Contains the host IP and port — the single source of truth for the DB location.
DATABASE_URL=postgres://postgres:postgres@<db-host>:5432/economy?sslmode=disable

# Name of the local development database created by `npm run db:create`
# and populated by `npm run db:seed`. Lives on the same server as DATABASE_URL.
DEV_DB_NAME=economy_dev

# Optional: create a `.env.development` file to point `next dev` at the seeded
# development database. Next.js loads it automatically in development, e.g.:
#   DATABASE_URL=postgres://postgres:postgres@<db-host>:5432/economy_dev?sslmode=disable
